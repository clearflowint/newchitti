# ==========================================
# 1. APPLICATION & DOMAIN CONFIGURATION
# ==========================================
ENVIRONMENT=production
PORT=8000
SECRET_KEY=generate_a_random_32_character_string_here
FRONTEND_URL=https://chitticlearflow.duckdns.org
BACKEND_URL=https://chitticlearflow.duckdns.org
ALLOWED_ORIGINS=https://chitticlearflow.duckdns.org
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==========================================
# 2. GOOGLE OAUTH 2.0 (DAY-1 AUTHENTICATION)
# ==========================================
GOOGLE_CLIENT_ID=1064759751491-c0m2q607id2qtq25ciogmhnpjso1soqk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://chitticlearflow.duckdns.org/api/auth/google/callback

# ==========================================
# 3. NOCODB DATABASE ENGINE & TABLE IDs
# ==========================================
# Base URL without trailing slashes or /api path
NOCODB_BASE_URL=https://nocodb.your-domain.com
NOCODB_API_TOKEN=your_nocodb_api_token_here
NOCODB_BASE_ID=your_nocodb_base_id_here

# NocoDB v2 API requires exact Table IDs (e.g. m_abc123), NOT display names
NOCODB_TABLE_MANAGERS=tbl_managers_id_here
NOCODB_TABLE_CHITTIS=tbl_chittis_id_here
NOCODB_TABLE_SHARES=tbl_shares_id_here
NOCODB_TABLE_TRANSACTIONS=tbl_transactions_id_here

